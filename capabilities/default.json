{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set for Chiroot Desktop main window, local High Sierra proxy, and Chiroot web origin",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:47821/*",
      "http://127.0.0.1:*/*",
      "http://127.0.0.1:*/**",
      "http://localhost:*/*",
      "http://localhost:*/**",
      "https://www.chiroot.my.id/*",
      "https://chiroot.my.id/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "deep-link:default",
    "allow-get-app-entry-url",
    "allow-open-external-url",
    "allow-pick-import-files",
    "allow-read-imported-file-chunk",
    "allow-release-imported-file",
    "allow-list-macos-audio-devices",
    "allow-start-google-auth",
    "allow-complete-oauth-from-url",
    "allow-get-auth-session",
    "allow-logout-auth",
    "allow-sync-web-session"
  ]
}
