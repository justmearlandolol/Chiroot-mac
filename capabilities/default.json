{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set for Chiroot Desktop main window, local High Sierra proxy, and Chiroot web origin",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/**",
      "http://localhost:*",
      "http://localhost:*/**",
      "https://www.chiroot.my.id/*",
      "https://chiroot.my.id/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "deep-link:default"
  ]
}
